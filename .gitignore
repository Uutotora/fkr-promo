# dependencies — restore with `npm ci` and `pip install -r requirements.txt`
node_modules/
.venv/
__pycache__/
# full-quality renders live in GitHub Releases (files > 100 MB); a compressed preview is in preview/
out/
# raw review frames (regenerate with `node stills.mjs`); contact sheets are kept
stills/**/*.png
*.log
.DS_Store

# v13 live plates (large, regenerated from ИИ_промо/v13)
public/v13/

# v14 media (large, regenerated by ИИ_промо/v14/tools/prep.sh and prep2.py); the cursor tracks are code inputs
public/v14/*
!public/v14/*_track.json
